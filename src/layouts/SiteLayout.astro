---
import '../styles/global.css';
import '../styles/components.css';
import '../styles/desktop-refinement.css';
import '../styles/mobile-refinement.css';
import PreviewBanner from '../components/PreviewBanner.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
import { siteConfig } from '../content/siteConfig';

interface Props {
  title?: string;
  description?: string;
  activeRoute?: string;
  isHome?: boolean;
}

const {
  title = `${siteConfig.institutionName} — Membesar bersama Al-Quran`,
  description = 'Pendidikan tahfiz dan pembinaan sahsiah untuk pelajar perempuan berumur 10 hingga 17 tahun di Shah Alam, Selangor.',
  activeRoute = '/',
  isHome = false
} = Astro.props;

const previewBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalPath = previewBase && Astro.url.pathname.startsWith(`${previewBase}/`)
  ? Astro.url.pathname.slice(previewBase.length) : Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath, siteConfig.canonicalBase).href;
const isInternalMode = siteConfig.publicationMode === 'internal';
const robotsDirective = (isInternalMode || activeRoute === '/404') ? 'noindex, nofollow' : 'index, follow';
---
<!doctype html>
<html lang="ms-MY">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#123F35" />
    <meta name="robots" content={robotsDirective} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Meta -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.brandName} />
    <meta property="og:locale" content="ms_MY" />
    <meta property="og:image" content={new URL("/assets/phase3/header-main-1600.webp", siteConfig.canonicalBase).href} />

    <!-- Favicon -->
    <link rel="icon" type="image/webp" href="/assets/logo-madum.webp" />
  </head>
  <body>
    <a href="#main-content" class="sr-only">Langkau ke kandungan utama</a>

    <AnnouncementBar />
    <SiteHeader activeRoute={activeRoute} />

    <main tabindex="-1" id="main-content" class={isHome ? '' : 'inner'}>
      <slot />
    </main>

    <SiteFooter />
    <MobileStickyBar />

    <script>
      // Keep copyright year synchronized
      document.querySelectorAll('.year').forEach(el => {
        el.textContent = String(new Date().getFullYear());
      });

      import '../scripts/mobileExperience';

    </script>
  </body>
</html>
