---
import SiteLayout from '../layouts/SiteLayout.astro';
import PrimaryCTA from '../components/PrimaryCTA.astro';
import WhatsAppInquiryForm from '../components/WhatsAppInquiryForm.astro';
import { admissionsSteps, admissionsChecklist, feeItems } from '../content/fees';
import { siteConfig } from '../content/siteConfig';

const title = "Kemasukan & Yuran | MADUM — Pratonton UI/UX";
const description = "Pratonton dalaman halaman Kemasukan & Yuran MADUM. Belum diterbitkan sebagai laman rasmi.";
---
<SiteLayout title={title} description={description} activeRoute="/kemasukan">
  <!-- Inner Hero -->
  <section class="inner-hero" aria-labelledby="kemasukan-hero-title">
    <div class="container inner-hero-inner">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Utama</a><b>/</b><span>Kemasukan &amp; Yuran</span>
        </nav>
        <div class="eyebrow">KEMASUKAN SESI {siteConfig.admissionsSession}</div>
        <h1 id="kemasukan-hero-title">
          Langkah pertama menuju <em>pengajian Al-Quran.</em>
        </h1>
        <p class="inner-lead">
          Semak syarat kelayakan, anggaran yuran berdasarkan profil rujukan dan salurkan pertanyaan kepada pihak maahad melalui WhatsApp.
        </p>
        <a class="btn btn-primary" href="#pertanyaan">
          Tanya Kemasukan <span class="arrow" aria-hidden="true">↓</span>
        </a>
      </div>

      <div class="inner-hero-image">
        <img
          src="/assets/hero-kelas.webp"
          alt="Dokumentasi asal MADUM"
          loading="eager"
          width="485"
          height="385"
        />
        <span class="inner-photo-tag">
          Suasana kelas MADUM
          <small>Dokumentasi sebenar maahad</small>
        </span>
      </div>
    </div>
  </section>

  <!-- Cara Memulakan -->
  <section class="section-compact surface-white" aria-labelledby="langkah-title">
    <div class="container">
      <div class="eyebrow">CARA MEMULAKAN</div>
      <h2 class="section-title" id="langkah-title">Proses pertanyaan yang ringkas.</h2>
      <div class="steps">
        {admissionsSteps.map(step => (
          <div class="step">
            <span class="number">{step.num}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Kelayakan Asas -->
  <section class="section-compact surface-soft" aria-labelledby="syarat-title">
    <div class="container">
      <div class="eyebrow">KELAYAKAN ASAS</div>
      <h2 class="section-title" id="syarat-title">Siapa yang boleh memohon?</h2>
      <p class="section-sub">Syarat berikut berdasarkan hebahan pendaftaran klien.</p>
      <ul class="checklist">
        {admissionsChecklist.map(item => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Rujukan Yuran -->
  <section class="section-compact surface-cream" id="yuran" aria-labelledby="yuran-title">
    <div class="container">
      <div class="eyebrow">RUJUKAN YURAN</div>
      <h2 class="section-title" id="yuran-title">Struktur yuran pengajian.</h2>
      <p class="section-sub">
        Nilai daripada dokumen profil sesi {siteConfig.admissionsSession} yang dibekalkan oleh klien. Bukan pengesahan kadar terkini.
      </p>

      <div class="review-note">
        <strong>Semakan sebelum terbit:</strong> semua kadar, kaedah bantuan asnaf, dan syarat pembayaran perlu disahkan pihak maahad. Pratonton ini tidak menerima pembayaran.
      </div>

      <div class="fees">
        {feeItems.map(fee => (
          <div class="fee-card">
            <div class="fee-top">
              <b>{fee.category}</b>
            </div>
            <div class="fee-body">
              <div class="value">{fee.value}</div>
              <span class="suffix">{fee.period}</span>
              <p>{fee.description}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="review-note" style="background:#f2f7ee;border-color:#dce8d8;color:#465f4e">
        Dokumen profil menyatakan kemudahan yuran kepada pelajar asnaf dan keluarga kurang berkemampuan; pelaksanaan dan kelayakan semasa perlu ditanya kepada pihak maahad.
      </div>
    </div>
  </section>

  <!-- Borang Pertanyaan -->
  <section id="pertanyaan" class="section-compact surface-white" aria-labelledby="pertanyaan-title">
    <div class="container two-cols wide-copy">
      <div>
        <div class="eyebrow">BORANG PERTANYAAN</div>
        <h2 class="section-title" id="pertanyaan-title">Dapatkan maklumat lanjut daripada pihak maahad.</h2>
        <p class="prose">
          Isi maklumat minimum yang diperlukan untuk menghasilkan mesej WhatsApp pada peranti anda. Laman pratonton tidak menyimpan maklumat ini di server.
        </p>
        <div class="info-card" style="min-height:0;margin-top:22px">
          <h3 style="font-size:21px">Apa berlaku selepas klik?</h3>
          <p>
            WhatsApp akan dibuka dengan teks yang telah disusun. Anda boleh menyemak dan menghantarnya sendiri kepada pentadbir maahad. Tiada pendaftaran rasmi disahkan secara automatik.
          </p>
        </div>
      </div>

      <div>
        <WhatsAppInquiryForm />
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <PrimaryCTA
    eyebrow="LANGKAH SETERUSNYA"
    title="Masih ada soalan tentang kemasukan?"
    description="Hubungi pihak maahad untuk maklumat pendaftaran dan yuran yang telah dikemas kini."
    ctaText="Tanya Kemasukan"
    ctaHref="/kemasukan#pertanyaan"
    disclaimer="Pratonton dalaman · Pengesahan diperlukan"
  />
</SiteLayout>
