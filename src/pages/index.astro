---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProgramCard from '../components/ProgramCard.astro';
import PrimaryCTA from '../components/PrimaryCTA.astro';
import { programsList, curriculumPillars } from '../content/programs';
import { siteConfig } from '../content/siteConfig';

const title = "MADUM — Pratonton Website (Konsep UI/UX v1.0)";
const description = "Pratonton konsep homepage Maahad Tahfiz Al Quran Darul Muthiah (1). Bukan laman rasmi yang diterbitkan.";
---
<SiteLayout title={title} description={description} activeRoute="/" isHome={true}>
  <!-- Hero Section -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="hero-note">
          <i></i> PENDIDIKAN TAHFIZ PUTERI · SHAH ALAM
        </div>
        <h1 id="hero-heading">
          Membesar bersama <em>Al-Quran,</em> ilmu &amp; tarbiah.
        </h1>
        <p class="hero-description">
          Pendidikan tahfiz dan pembinaan sahsiah untuk pelajar perempuan berumur 10 hingga 17 tahun, dalam persekitaran yang menitikberatkan ilmu, adab dan amalan harian.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/kemasukan#pertanyaan">
            Tanya Kemasukan <span class="arrow" aria-hidden="true">↗</span>
          </a>
          <a class="btn btn-outline" href="/pengajian">
            Kenali Pengajian <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <div class="hero-meta">
          <span class="hero-meta-item">
            <span class="tiny-icon" aria-hidden="true">✦</span> Hafazan &amp; Tarbiah
          </span>
          <span class="hero-meta-item">
            <span class="tiny-icon" aria-hidden="true">⌂</span> Shah Alam, Selangor
          </span>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-img-outer">
          <img
            src="/assets/hero-kelas.webp"
            class="hero-photo"
            alt="Dokumentasi sebenar suasana kelas pelajar MADUM"
            loading="eager"
            width="510"
            height="490"
          />
        </div>
        <div class="photo-credit">
          Suasana Pengajian MADUM
          <small>Dokumentasi asal pihak maahad</small>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Strip -->
  <div class="values-strip">
    <div class="container values-inner">
      <div class="value">
        <span class="value-no">01</span>
        <span>
          <b>Pendidikan Al-Quran</b>
          <small>Hafazan, bacaan dan penghayatan</small>
        </span>
      </div>
      <div class="value">
        <span class="value-no">02</span>
        <span>
          <b>Tarbiah &amp; Akhlak</b>
          <small>Pembentukan sahsiah dan amalan</small>
        </span>
      </div>
      <div class="value">
        <span class="value-no">03</span>
        <span>
          <b>Ilmu &amp; Kemahiran</b>
          <small>Akademik asas serta kokurikulum</small>
        </span>
      </div>
    </div>
  </div>

  <!-- Intro Section -->
  <section class="section intro-section" id="profil" aria-labelledby="profil-title">
    <div class="container intro-grid">
      <div class="intro-images">
        <img
          class="intro-image-main"
          src="/assets/aktiviti-tarbiah.webp"
          alt="Pelajar MADUM mengikuti aktiviti tarbiah berkumpulan"
          loading="lazy"
          width="420"
          height="420"
        />
        <img
          class="intro-image-side"
          src="/assets/belajar-halaqah.webp"
          alt="Sesi bacaan Al-Quran oleh pelajar MADUM"
          loading="lazy"
          width="260"
          height="260"
        />
      </div>
      <div class="intro-copy">
        <div class="eyebrow">MENGENALI DARUL MUTHIAH</div>
        <h2 id="profil-title">Membina generasi berilmu, beradab dan dekat dengan Al-Quran.</h2>
        <p>Maahad Tahfiz Al Quran Darul Muthiah (1) menumpukan pengajian Al-Quran bersama pendidikan agama, akademik asas dan pembentukan akhlak.</p>
        <p>Suasana pembelajaran dan aktiviti pelajar merupakan sebahagian daripada usaha melahirkan generasi yang mempunyai hala tuju pendidikan dan kehidupan.</p>
        <blockquote class="quote-box">
          “Pendidikan bukan sekadar mengejar pencapaian akademik.”
        </blockquote>
        <a class="text-link" href="/pengajian">
          Terokai pendidikan di MADUM <span>↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Programs Section -->
  <section class="section programs" id="pengajian" aria-labelledby="program-title">
    <div class="container">
      <div class="section-top">
        <div>
          <div class="eyebrow">LALUAN PENDIDIKAN</div>
          <h2 class="section-title" id="program-title">Program pengajian MADUM</h2>
          <p class="section-sub">Setiap laluan disusun untuk memberi ruang kepada pelajar mendalami Al-Quran, mengukuhkan pembelajaran dan mengembangkan potensi diri.</p>
        </div>
        <a class="text-link" href="/kemasukan">Maklumat kemasukan ↗</a>
      </div>

      <div class="programs-grid">
        {programsList.map(prog => (
          <ProgramCard
            num={prog.num}
            title={prog.title}
            description={prog.description}
            duration={prog.duration}
            href={prog.href}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Curriculum Section -->
  <section class="curriculum" aria-labelledby="curriculum-title">
    <div class="container">
      <div class="curriculum-top">
        <div>
          <div class="eyebrow">PENDIDIKAN MENYELURUH</div>
          <h2 id="curriculum-title">Lebih daripada hafazan.</h2>
        </div>
        <p>Pengajian di MADUM turut memberi perhatian kepada kefahaman agama, pendidikan asas, pembinaan sahsiah dan aktiviti kemahiran yang membantu perkembangan pelajar.</p>
      </div>

      <div class="curriculum-grid">
        {curriculumPillars.map(pillar => (
          <div class="pillar">
            <span class="pillar-symbol">{pillar.symbol}</span>
            <h3>{pillar.title}</h3>
            <p>{pillar.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Life & Gallery Section -->
  <section class="section life-section" id="galeri" aria-labelledby="galeri-title">
    <div class="container">
      <div class="section-top">
        <div>
          <div class="eyebrow">SUASANA DI MADUM</div>
          <h2 class="section-title" id="galeri-title">Kehidupan pelajar dalam gambar.</h2>
          <p class="section-sub">Sekilas suasana pembelajaran dan aktiviti berdasarkan dokumentasi sebenar yang dibekalkan oleh pihak maahad.</p>
        </div>
        <a class="text-link" href="/hubungi">Pertanyaan mengenai maahad ↗</a>
      </div>

      <div class="gallery-layout">
        <div class="gallery-item">
          <img
            class="gallery-img gallery-tall"
            src="/assets/kelas-akademik.webp"
            loading="lazy"
            alt="Pelajar belajar bersama dalam kelas akademik"
            width="400"
            height="398"
          />
          <span class="image-caption">Pembelajaran harian</span>
        </div>
        <div class="gallery-pair">
          <div class="gallery-item">
            <img
              class="gallery-img"
              src="/assets/kemahiran-tvet.webp"
              loading="lazy"
              alt="Pelajar mempelajari kemahiran menghasilkan sabun"
              width="300"
              height="191"
            />
            <span class="image-caption">Kemahiran &amp; TVET</span>
          </div>
          <div class="gallery-item">
            <img
              class="gallery-img"
              src="/assets/sukan-pelajar.webp"
              loading="lazy"
              alt="Pelajar menyertai aktiviti bola tampar"
              width="300"
              height="191"
            />
            <span class="image-caption">Riadah &amp; sukan</span>
          </div>
        </div>
        <div class="gallery-item">
          <img
            class="gallery-img gallery-tall"
            src="/assets/rehlah-pelajar.webp"
            loading="lazy"
            alt="Aktiviti lawatan sambil belajar pelajar MADUM"
            width="400"
            height="398"
          />
          <span class="image-caption">Rehlah &amp; lawatan</span>
        </div>
      </div>

      <div class="gallery-quote">
        <p>Dokumentasi sebenar membantu ibu bapa mengenali suasana pembelajaran dan kehidupan di maahad. Penerbitan gambar pelajar tertakluk kepada keizinan pihak berkaitan.</p>
        <a class="text-link" href="/hubungi">Hubungi pihak maahad ↗</a>
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <PrimaryCTA
    eyebrow={`PENGAMBILAN PELAJAR · SESI ${siteConfig.admissionsSession}`}
    title="Berminat mengetahui lebih lanjut tentang kemasukan?"
    description="Dapatkan penjelasan mengenai kelayakan, pengajian, yuran dan langkah seterusnya terus daripada pihak maahad."
    ctaText="Pertanyaan melalui WhatsApp"
    ctaHref={`https://wa.me/${siteConfig.whatsappE164}?text=Assalamualaikum.%20Saya%20ingin%20bertanya%20tentang%20kemasukan%20ke%20MADUM.`}
    isExternal={true}
    disclaimer="Maklumat rasmi perlu disahkan sebelum diterbitkan."
    sectionClass="final-cta-section"
  />
</SiteLayout>
