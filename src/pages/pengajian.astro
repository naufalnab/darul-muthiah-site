---
import SiteLayout from '../layouts/SiteLayout.astro';
import PrimaryCTA from '../components/PrimaryCTA.astro';
import ProgramCard from '../components/ProgramCard.astro';
import { programsList, curriculumPillars, dailySchedule } from '../content/programs';

const title = "Pengajian — MADUM";
const description = "Tiga laluan pengajian MADUM: Hafazan Al-Quran 30 Juzuk, Syahadah, dan SPM Fast Track JAIS bersama empat bidang pembelajaran menyeluruh.";
---
<SiteLayout title={title} description={description} activeRoute="/pengajian">
  <!-- Inner Hero -->
  <section class="inner-hero" aria-labelledby="pengajian-hero-title">
    <div class="container inner-hero-inner">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Utama</a><b>/</b><span>Pengajian</span>
        </nav>
        <div class="eyebrow">PENGAJIAN &amp; KURIKULUM</div>
        <h1 id="pengajian-hero-title">
          Ilmu yang dipelajari, <em>adab yang dibina.</em>
        </h1>
        <p class="inner-lead">
          Tiga laluan pengajian dengan gabungan pembelajaran Al-Quran, Dinniyah, akademik serta kokurikulum dalam kehidupan seharian pelajar.
        </p>
        <a class="btn btn-primary" href="#program">
          Lihat Laluan Pengajian <span class="arrow" aria-hidden="true">↓</span>
        </a>
      </div>

      <div class="inner-hero-image">
        <img
          src="/assets/belajar-halaqah.webp"
          alt="Dokumentasi asal sesi bacaan Al-Quran"
          loading="eager"
          width="485"
          height="385"
        />
        <span class="inner-photo-tag">
          Sesi bacaan Al-Quran
          <small>Dokumentasi sebenar maahad</small>
        </span>
      </div>
    </div>
  </section>

  <!-- Pilihan Laluan -->
  <section class="section-compact surface-white" id="program" aria-labelledby="laluan-title">
    <div class="container">
      <div class="section-top">
        <div>
          <div class="eyebrow">PILIHAN LALUAN</div>
          <h2 class="section-title" id="laluan-title">Tiga fokus pengajian utama.</h2>
          <p class="section-sub">Tempoh adalah anggaran dan bergantung kepada program serta perkembangan pelajar.</p>
        </div>
        <a class="text-link" href="/kemasukan">Syarat kemasukan ↗</a>
      </div>

      <div class="programs-grid">
        {programsList.map(prog => (
          <ProgramCard
            num={prog.num}
            title={prog.title}
            description={prog.description}
            duration={prog.duration}
            href="/kemasukan"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Sukatan Pelajaran -->
  <section class="section-compact surface-soft" aria-labelledby="sukatan-title">
    <div class="container">
      <div class="eyebrow">SUKATAN PELAJARAN</div>
      <h2 class="section-title" id="sukatan-title">Empat bidang pembelajaran.</h2>
      <div class="pillars-light">
        {curriculumPillars.map(pillar => (
          <article class="pillar-light">
            <span class="symbol">{pillar.symbol}</span>
            <h3>{pillar.title}</h3>
            <p>{pillar.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Rutin Pelajar -->
  <section class="section-compact surface-cream" aria-labelledby="rutin-title">
    <div class="container two-cols">
      <div>
        <div class="eyebrow">RUTIN PELAJAR</div>
        <h2 class="section-title" id="rutin-title">Kehidupan teratur bersama Al-Quran.</h2>
        <p class="section-sub">Gambaran ringkas aktiviti harian daripada dokumen profil. Jadual terperinci tertakluk kepada perubahan institusi.</p>
        <div class="schedule">
          {dailySchedule.map(item => (
            <div class="schedule-item">
              <span class="schedule-time">{item.timeLabel}</span>
              <div>
                <strong>{item.title}</strong>
                <p>{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <img
        class="editorial-visual"
        src="/assets/kelas-akademik.webp"
        alt="Pelajar mengikuti pembelajaran di dalam kelas"
        loading="lazy"
        width="480"
        height="440"
      />
    </div>
  </section>

  <!-- Pembelajaran Melalui Pengalaman -->
  <section class="section-compact surface-white" aria-labelledby="amali-title">
    <div class="container two-cols">
      <img
        class="editorial-visual"
        src="/assets/kemahiran-tvet.webp"
        alt="Dokumentasi aktiviti kemahiran TVET"
        loading="lazy"
        width="480"
        height="440"
      />
      <div>
        <div class="eyebrow">PEMBELAJARAN MELALUI PENGALAMAN</div>
        <h2 class="section-title" id="amali-title">Ilmu, kemahiran &amp; kegiatan luar bilik darjah.</h2>
        <p class="prose">
          Selain pengajian formal, dokumentasi menunjukkan aktiviti kemahiran praktikal, program keselamatan, kegiatan sukan serta lawatan sambil belajar yang menyokong perkembangan pelajar.
        </p>
        <a class="text-link" href="/galeri">Lihat dokumentasi aktiviti ↗</a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <PrimaryCTA
    eyebrow="LANGKAH SETERUSNYA"
    title="Kenali laluan terbaik untuk calon pelajar."
    description="Pihak maahad boleh membantu menjelaskan kesesuaian program, tempoh serta syarat kemasukan."
    ctaText="Tanya Kemasukan"
    ctaHref="/kemasukan#pertanyaan"
    disclaimer="Pratonton dalaman · Pengesahan diperlukan"
  />
</SiteLayout>
