---
---
<dialog class="lightbox" id="image-viewer" aria-label="Paparan gambar besar">
  <button type="button" id="close-viewer" aria-label="Tutup gambar">
    Tutup ✕
  </button>
  <img id="image-large" alt="" src="/assets/preview-placeholder.svg" width="1080" height="810" />
  <p id="image-caption" aria-live="polite"></p>
  <div class="lightbox-navigation"><button type="button" id="previous-image" aria-label="Gambar sebelumnya">← Sebelumnya</button><button type="button" id="next-image" aria-label="Gambar seterusnya">Seterusnya →</button></div>
</dialog>

<script>
  const viewer = document.getElementById('image-viewer') as HTMLDialogElement | null;
  const largeImg = document.getElementById('image-large') as HTMLImageElement | null;
  const captionEl = document.getElementById('image-caption');
  const closeBtn = document.getElementById('close-viewer');
  let openerElement: HTMLElement | null = null;

  function openLightbox(card: HTMLElement) {
    if (!viewer || !largeImg) return;
    openerElement = card;
    const img = card.querySelector('img');
    const boldTitle = card.querySelector('.gallery-caption b');
    
    if (img) {
      largeImg.src = img.src;
      largeImg.alt = img.alt || '';
    }
    if (captionEl && boldTitle) {
      captionEl.textContent = boldTitle.textContent;
    }

    if (typeof viewer.showModal === 'function') {
      viewer.showModal();
    } else {
      viewer.classList.add('open');
    }
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeLightbox() {
    if (!viewer || !largeImg) return;
    if (typeof viewer.close === 'function') {
      viewer.close();
    }
    viewer.classList.remove('open');
    largeImg.src = document.querySelector<HTMLImageElement>('.gallery-card img')?.src || largeImg.src;
    document.body.style.overflow = '';
    if (openerElement) {
      openerElement.focus();
      openerElement = null;
    }
  }

  function stepImage(direction: number) {
    const cards = [...document.querySelectorAll<HTMLElement>('.gallery-card:not([hidden])')];
    if (!cards.length || !openerElement || !largeImg) return;
    const next = cards[(cards.indexOf(openerElement) + direction + cards.length) % cards.length];
    openerElement = next;
    const img = next.querySelector('img');
    if (img) { largeImg.src = img.src; largeImg.alt = img.alt; }
    if (captionEl) captionEl.textContent = next.querySelector('.gallery-caption b')?.textContent || '';
  }
  document.getElementById('previous-image')?.addEventListener('click', () => stepImage(-1));
  document.getElementById('next-image')?.addEventListener('click', () => stepImage(1));
  viewer?.addEventListener('keydown', event => {
    if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
      event.preventDefault(); stepImage(event.key === 'ArrowLeft' ? -1 : 1);
    }
  });

  // Bind cards
  document.querySelectorAll<HTMLElement>('.gallery-card').forEach(card => {
    card.addEventListener('click', () => openLightbox(card));

  });

  closeBtn?.addEventListener('click', closeLightbox);

  // Close on backdrop click
  viewer?.addEventListener('click', (e) => {
    if (e.target === viewer) {
      closeLightbox();
    }
  });

  // Native cancel/esc listener
  viewer?.addEventListener('cancel', (e) => {
    e.preventDefault();
    closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && viewer && (viewer.open || viewer.classList.contains('open'))) {
      closeLightbox();
    }
  });
</script>
