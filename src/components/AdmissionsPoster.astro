---
import { siteConfig } from '../content/siteConfig';
---
<section class="section-compact surface-cream" id="kempen-2027" aria-labelledby="update-2027-title">
  <div class="container campaign-grid">
    <div class="admissions-poster" role="group" aria-label="Konsep poster pengambilan 2027, menunggu pengesahan institusi">
      <span class="poster-kicker">DARUL MUTHIAH · TAHFIZ PUTERI</span>
      <span class="poster-session">SESI {siteConfig.admissionsSession}</span>
      <h2 id="update-2027-title">Mulakan perjalanan<br /><em>bersama Al-Quran.</em></h2>
      <p>Hafazan · Ilmu · Tarbiah</p>
      <div class="poster-rule" aria-hidden="true"></div>
      <p>Shah Alam, Selangor</p>
      <span class="poster-kicker">Konsep poster · Menunggu kelulusan</span>
    </div>
    <div>
      <div class="eyebrow">KEMASUKAN 2027</div>
      <h3 class="section-title">Kenali laluan pengajian puteri.</h3>
      <p class="section-sub">Semak program dan kelayakan asas terlebih dahulu. Sesi, tarikh pengambilan dan syarat akhir tertakluk kepada pengesahan pihak maahad.</p>
      <div class="campaign-actions">
        <a class="btn btn-primary" href="/pengajian">Terokai Pengajian <span aria-hidden="true">→</span></a>
        <a class="text-link" href="#pertanyaan">Semak saluran pertanyaan ↓</a>
      </div>
      <div class="registration-status" data-registration-status="pending">
        <strong>Pendaftaran belum diaktifkan</strong>
        <p>QR dan borang akan tersedia selepas ujian akses, penghantaran serta penerimaan permohonan selesai dan pihak maahad memberi pengesahan.</p>
      </div>
      <p class="verification-note">Rujukan kempen: 28 Oktober 2026 · Visual poster ini ialah konsep neutral.</p>
    </div>
  </div>
</section>
